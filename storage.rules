rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /answers/{taskId}/{fileName} {
      allow read, write: if request.auth != null && request.resource.size < 20 * 1024 * 1024;
    }
    match /submissions/{taskId}/{studentId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == studentId
                         && request.resource.size < 20 * 1024 * 1024;
    }
  }
}

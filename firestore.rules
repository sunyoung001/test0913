rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['admin@test0913.app', 'su1413911@gmail.com']; }
    function isTeacher() { return isAdmin() || (signedIn() && userRole() == 'teacher'); }
    function teacherInvite() { return get(/databases/$(database)/documents/teacherInvites/$(request.auth.token.email)).data; }
    function canManageTask(data) {
      return isAdmin() || (isTeacher()
        && data.classNames.hasOnly(teacherInvite().classNames));
    }
    function canReadTask(data) {
      return isAdmin()
        || (isTeacher() && data.classNames.hasAny(teacherInvite().classNames))
        || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'student'
            && data.classNames.hasAny([get(/databases/$(database)/documents/users/$(request.auth.uid)).data.className]));
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin()
                    || (isTeacher() && resource.data.accountType == 'student'));
      allow create: if signedIn() && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['role']);
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == userId
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved', 'classNames']))
                    || (isTeacher() && resource.data.accountType == 'student'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'updatedAt']));
    }
    match /teacherInvites/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow create, update, delete: if isAdmin();
    }
    match /tasks/{taskId} {
      allow read: if canReadTask(resource.data);
      allow create, update: if canManageTask(request.resource.data);
      allow delete: if canManageTask(resource.data);
    }
    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /submissions/{submissionId} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow update: if isTeacher();
    }
    match /files/{fileId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && (request.resource.data.kind == 'submission' || isTeacher());
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isTeacher() || resource.data.kind == 'code');
      match /chunks/{chunkId} {
        allow create: if signedIn()
          && get(/databases/$(database)/documents/files/$(fileId)).data.ownerId == request.auth.uid;
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/files/$(fileId)).data.ownerId == request.auth.uid || isTeacher()
              || get(/databases/$(database)/documents/files/$(fileId)).data.kind == 'code');
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'su1413911@gmail.com'; }
    function isTeacher() { return isAdmin() || (signedIn() && userRole() == 'teacher'); }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['role']);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }
    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /submissions/{submissionId} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow update: if isTeacher();
    }
  }
}
